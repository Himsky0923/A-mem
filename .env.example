# Copy to .env (gitignored) and fill in. test_advanced_robust.py loads it at start-up;
# variables already set in the shell take precedence.

# --backend openai: key for the OpenAI-compatible API (here: DeepSeek)
OPENAI_API_KEY=your-deepseek-api-key

# Endpoint for --backend openai (or pass --base_url). Leave unset for api.openai.com.
OPENAI_BASE_URL=https://api.deepseek.com
